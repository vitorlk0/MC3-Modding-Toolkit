{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-seek",
    "fs:allow-fstat",
    "fs:allow-rename",
    "fs:allow-remove",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }, { "path": "**/*" }] }
  ]
}
